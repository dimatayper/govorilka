# SPDX-License-Identifier: AGPL-3.0-or-later
[Desktop Entry]
Name=Govorilka Canary
GenericName=Instant Messenger
Comment=Canary build of Govorilka
Exec=app.govorilka.GovorilkaCanary %U
TryExec=app.govorilka.GovorilkaCanary
Icon=app.govorilka.GovorilkaCanary
Type=Application
Categories=Network;InstantMessaging;Chat;
Keywords=chat;im;messaging;messenger;voip;voice;video;call;
StartupWMClass=app.govorilka.GovorilkaCanary
SingleMainWindow=true
StartupNotify=true
MimeType=x-scheme-handler/govorilka;
Terminal=false
X-GNOME-UsesNotifications=true
Actions=open-settings;new-dm;

[Desktop Action open-settings]
Name=Open Settings
Exec=app.govorilka.GovorilkaCanary --fluxer-task=open-settings %U

[Desktop Action new-dm]
Name=New Direct Message
Exec=app.govorilka.GovorilkaCanary --fluxer-task=new-dm %U
