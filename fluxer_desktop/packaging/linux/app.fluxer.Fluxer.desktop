# SPDX-License-Identifier: AGPL-3.0-or-later
[Desktop Entry]
Name=Govorilka
GenericName=Instant Messenger
Comment=Instant messaging and VoIP
Exec=app.govorilka.Govorilka %U
TryExec=app.govorilka.Govorilka
Icon=app.govorilka.Govorilka
Type=Application
Categories=Network;InstantMessaging;Chat;
Keywords=chat;im;messaging;messenger;voip;voice;video;call;
StartupWMClass=app.govorilka.Govorilka
SingleMainWindow=true
StartupNotify=true
MimeType=x-scheme-handler/govorilka;
Terminal=false
X-GNOME-UsesNotifications=true
Actions=open-settings;new-dm;

[Desktop Action open-settings]
Name=Open Settings
Exec=app.govorilka.Govorilka --fluxer-task=open-settings %U

[Desktop Action new-dm]
Name=New Direct Message
Exec=app.govorilka.Govorilka --fluxer-task=new-dm %U
